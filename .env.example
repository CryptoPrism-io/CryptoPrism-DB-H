# CryptoPrism-DB-H Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================
# PostgreSQL Database Configuration
# ============================================

# Database Host (GCP PostgreSQL Instance)
DB_HOST=your_postgresql_host

# Primary Database Name
DB_NAME=cp_ai

# Database Username
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# Database Port (default: 5432)
DB_PORT=5432

# ============================================
# Optional: Additional Database Connections
# ============================================

# Production Database (for future expansion)
DB_NAME_PROD=dbcp

# Backtest Database (for historical hourly data)
DB_NAME_BT=cp_backtest_h

# ============================================
# Optional: API Keys (for future features)
# ============================================

# CoinMarketCap API Key (if needed for hourly listings)
# CMC_API_KEY=your_cmc_api_key

# ============================================
# Optional: Notification Services
# ============================================

# Telegram Bot Configuration (for alerts)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Google Gemini API Key (for AI-powered QA)
# GEMINI_API_KEY=your_gemini_api_key

# ============================================
# Notes
# ============================================
# - NEVER commit the .env file to version control
# - Ensure .env is listed in .gitignore
# - For GitHub Actions, configure these as repository secrets
# - All credentials should be kept secure and rotated regularly
