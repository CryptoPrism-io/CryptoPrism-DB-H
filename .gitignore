# ============================================
# CryptoPrism-DB-H .gitignore
# ============================================

# ============================================
# Environment & Secrets
# ============================================
.env
.env.*
!.env.example
*.env
config.ini
secrets.yaml
credentials.json

# ============================================
# Python
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Virtual environments
venv/
ENV/
env/
.venv
env.bak/
venv.bak/

# ============================================
# R
# ============================================
.Rhistory
.RData
.Rapp.history
.Rproj.user/
*.Rproj
.httr-oauth

# R Environment Variables
.Renviron

# RStudio files
.Rproj.user

# pkgdown site
# docs/ - Now allowing docs/reports/ for project documentation
!docs/
!docs/reports/

# ============================================
# IDEs & Editors
# ============================================
# VS Code
.vscode/
*.code-workspace

# Claude Code
.claude/

# PyCharm
.idea/
*.iml

# JetBrains
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# Logs & Temporary Files
# ============================================
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~.nib
app.log

# ============================================
# Data Files & Outputs
# ============================================
# CSV outputs (optionally exclude if you want to track them)
csv_output/
*.csv

# Database dumps
*.sql
*.db
*.sqlite
*.sqlite3

# Excel files
*.xlsx
*.xls

# Compressed files
*.zip
*.tar.gz
*.rar
*.7z

# ============================================
# Project-Specific
# ============================================
# Backup files
backups/
*.backup
*.bak
*_backup.*
*_old.*

# Test files
test_output/
sandbox/

# Documentation builds
_build/
site/

# ============================================
# CI/CD & Deployment
# ============================================
.github/workflows/*_local.yml

# ============================================
# Notes
# ============================================
# CRITICAL: Always ensure .env files are never committed
# Add csv_output/ to version control if you want to track outputs
# Adjust data file patterns based on project needs
